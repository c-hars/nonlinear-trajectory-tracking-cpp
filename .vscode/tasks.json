{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-g", "-O0",
                "-D_USE_MATH_DEFINES",
                "-I", "C:/Users/conor/eigen",
                "${file}",
                "-o", "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Debug build — no optimisation, full symbols"
        },
        {
            "label": "Build (Release)",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-O2",
                "-D_USE_MATH_DEFINES",
                "-DNDEBUG",
                "-DEIGEN_NO_DEBUG",
                "-I", "C:/Users/conor/eigen",
                "${file}",
                "-o", "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Release build — matches Teensy optimisation flags"
        }
    ]
}
